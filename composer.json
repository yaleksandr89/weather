{
    "name": "yaleksandr89/weather",
    "description": "Package for retrieving current weather by coordinates",
    "type": "library",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Yaleksandr\\Weather\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Yaleksandr\\Weather\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Aleksandr Yurchenko",
            "email": "y.aleksandr89@yandex.ru"
        }
    ],
    "require": {
        "php": "^8.4",
        "guzzlehttp/guzzle": "^8.0.1",
        "psr/http-client": "^1.0.3",
        "psr/http-factory": "^1.1.0",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.2.5",
        "phpstan/phpstan": "^2.2.6",
        "phpstan/phpstan-deprecation-rules": "^2.0.5",
        "friendsofphp/php-cs-fixer": "^3.95.17"
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse",
        "cs:check": "php-cs-fixer check --diff",
        "cs:fix": "php-cs-fixer fix",
        "check": [
            "@test",
            "@analyse",
            "@cs:check"
        ]
    }
}
