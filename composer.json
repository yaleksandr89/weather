{
    "name": "yaleksandr89/weather",
    "description": "Package for retrieving current weather by coordinates",
    "homepage": "https://github.com/yaleksandr89/weather",
    "keywords": [
        "weather",
        "current-weather",
        "open-meteo",
        "weatherapi",
        "weather-api",
        "psr-17",
        "psr-18"
    ],
    "authors": [
        {
            "name": "Александр Юрченко",
            "email": "y.aleksandr89@yandex.ru",
            "homepage": "https://github.com/yaleksandr89",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/yaleksandr89/weather/issues",
        "source": "https://github.com/yaleksandr89/weather",
        "forum": "https://github.com/yaleksandr89/weather/discussions",
        "security": "https://github.com/yaleksandr89/weather/security/policy"
    },
    "funding": [
        {
            "type": "other",
            "url": "https://boosty.to/backendbezpafosa"
        },
        {
            "type": "other",
            "url": "https://sponsr.ru/backendbezpafosa/"
        }
    ],
    "type": "library",
    "license": "MIT",
    "require": {
        "php": "^8.4",
        "guzzlehttp/guzzle": "^8.0.1",
        "psr/http-client": "^1.0.3",
        "psr/http-factory": "^1.1.0",
        "psr/http-message": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^13.2.5",
        "phpstan/phpstan": "^2.2.6",
        "phpstan/phpstan-deprecation-rules": "^2.0.5",
        "friendsofphp/php-cs-fixer": "^3.95.17"
    },
    "autoload": {
        "psr-4": {
            "Yaleksandr\\Weather\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Yaleksandr\\Weather\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "coverage": [
            "@putenv XDEBUG_MODE=coverage",
            "phpunit --coverage-clover coverage.xml --coverage-text"
        ],
        "analyse": "phpstan analyse",
        "cs:check": "php-cs-fixer check --diff",
        "cs:fix": "php-cs-fixer fix",
        "check": [
            "@composer validate --strict",
            "@composer audit",
            "@cs:check",
            "@analyse",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    }
}
